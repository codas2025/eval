# Copy to .env.local and fill in to enable Firestore submission.
# Values are read at build time and embedded in the static bundle.
# These are NOT secrets — security comes from Firestore rules. See README.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional override; defaults to "clinical-eval-responses".
# VITE_FIREBASE_COLLECTION=clinical-eval-responses
